/*
 * ============================================================
 *                ROUND ROBIN SCHEDULING
 * ============================================================
 *
 * Description:
 *     Round Robin is a preemptive CPU scheduling algorithm.
 *
 *     Each process receives CPU for a fixed amount of time
 *     called the Time Quantum.
 *
 * ============================================================
 */

#include <stdio.h>

int main()
{
    int n;
    int quantum;

    printf("================================================\n");
    printf("             ROUND ROBIN SCHEDULING\n");
    printf("================================================\n");

    printf("\nEnter number of processes: ");
    scanf("%d", &n);

    if (n <= 0)
    {
        printf("Invalid number of processes.\n");
        return 1;
    }

    int burstTime[n];
    int remainingTime[n];
    int waitingTime[n];
    int turnaroundTime[n];

    printf("\nEnter burst times:\n");

    for (int i = 0; i < n; i++)
    {
        printf("P%d: ", i + 1);
        scanf("%d", &burstTime[i]);

        if (burstTime[i] <= 0)
        {
            printf("Invalid burst time.\n");
            return 1;
        }

        remainingTime[i] = burstTime[i];
        waitingTime[i] = 0;
    }

    printf("\nEnter time quantum: ");
    scanf("%d", &quantum);

    if (quantum <= 0)
    {
        printf("Invalid time quantum.\n");
        return 1;
    }

    int currentTime = 0;
    int completed = 0;

    printf("\n================================================\n");
    printf("             EXECUTION TRACE\n");
    printf("================================================\n");

    while (completed < n)
    {
        int executed = 0;

        for (int i = 0; i < n; i++)
        {
            if (remainingTime[i] > 0)
            {
                executed = 1;

                printf(
                    "Time %d -> %d : P%d\n",
                    currentTime,
                    currentTime +
                    (remainingTime[i] > quantum
                         ? quantum
                         : remainingTime[i]),
                    i + 1
                );

                if (remainingTime[i] > quantum)
                {
                    currentTime += quantum;
                    remainingTime[i] -= quantum;
                }
                else
                {
                    currentTime += remainingTime[i];

                    remainingTime[i] = 0;

                    /*
                     * Completion Time - Burst Time
                     * gives Waiting Time when all
                     * processes arrive at time 0.
                     */
                    waitingTime[i] =
                        currentTime - burstTime[i];

                    completed++;
                }
            }
        }

        /*
         * Safety check.
         */
        if (!executed)
        {
            break;
        }
    }

    double totalWT = 0;
    double totalTAT = 0;

    printf("\n------------------------------------------------------------\n");

    printf("Process\tBT\tWT\tTAT\n");

    printf("------------------------------------------------------------\n");

    for (int i = 0; i < n; i++)
    {
        turnaroundTime[i] =
            waitingTime[i] + burstTime[i];

        totalWT += waitingTime[i];
        totalTAT += turnaroundTime[i];

        printf(
            "P%d\t%d\t%d\t%d\n",
            i + 1,
            burstTime[i],
            waitingTime[i],
            turnaroundTime[i]
        );
    }

    printf("------------------------------------------------------------\n");

    printf(
        "Average Waiting Time    : %.2f\n",
        totalWT / n
    );

    printf(
        "Average Turnaround Time : %.2f\n",
        totalTAT / n
    );

    printf("============================================================\n");

    return 0;
}
