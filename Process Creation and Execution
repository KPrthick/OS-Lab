/*
 * ============================================================
 *              PROCESS CREATION AND EXECUTION
 * ============================================================
 *
 * Description:
 *     Demonstrates creation of a child process and execution
 *     of another program using execl().
 *
 * Functions:
 *     fork()
 *     execl()
 *     wait()
 *
 * ============================================================
 */

#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <stdlib.h>

int main()
{
    printf("================================================\n");
    printf("          PROCESS CREATION AND EXECUTION\n");
    printf("================================================\n");

    int pid = fork();

    if (pid < 0)
    {
        printf("Process creation failed.\n");
        return 1;
    }

    if (pid == 0)
    {
        /*
         * Child process
         */
        printf("\nChild process created.\n");

        printf("Child PID  = %d\n", getpid());
        printf("Parent PID = %d\n", getppid());

        printf("Child is executing 'ls' command...\n\n");

        execl("/bin/ls", "ls", "-l", NULL);

        /*
         * This statement executes only if execl()
         * fails.
         */
        perror("execl failed");

        exit(1);
    }
    else
    {
        /*
         * Parent process
         */
        printf("\nParent process created child.\n");
        printf("Parent PID = %d\n", getpid());
        printf("Child PID  = %d\n", pid);

        printf("Parent waiting for child...\n");

        wait(NULL);

        printf("Child execution completed.\n");
        printf("Parent process completed.\n");
    }

    printf("\n================================================\n");

    return 0;
}
