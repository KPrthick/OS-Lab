/*
 * ============================================================
 *              PROCESS CREATION USING fork()
 * ============================================================
 *
 * Description:
 *     Demonstrates creation of a child process using fork().
 *
 *     fork() creates a new process.
 *
 *     Return values:
 *       -1 : Fork failed
 *        0 : Child process
 *       >0 : Parent process
 *
 * ============================================================
 */

#include <stdio.h>
#include <unistd.h>
#include <stdlib.h>

int main()
{
    printf("================================================\n");
    printf("          PROCESS CREATION USING fork()\n");
    printf("================================================\n");

    printf("\nBefore fork():\n");
    printf("This statement is executed by the original process.\n");

    int processID = fork();

    if (processID < 0)
    {
        printf("\nError: Process creation failed.\n");
        return 1;
    }

    /*
     * Child process
     */
    if (processID == 0)
    {
        printf("\n---------------- CHILD PROCESS ----------------\n");

        printf("This is the child process.\n");
        printf("Child PID    : %d\n", getpid());
        printf("Parent PID   : %d\n", getppid());

        printf("Child process completed.\n");
    }

    /*
     * Parent process
     */
    else
    {
        printf("\n---------------- PARENT PROCESS ----------------\n");

        printf("This is the parent process.\n");
        printf("Parent PID   : %d\n", getpid());
        printf("Child PID    : %d\n", processID);

        printf("Parent process completed.\n");
    }

    printf("\n================================================\n");

    return 0;
}
