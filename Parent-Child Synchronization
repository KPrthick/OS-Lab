/*
 * ============================================================
 *           PARENT-CHILD SYNCHRONIZATION USING wait()
 * ============================================================
 *
 * Description:
 *     The parent process creates a child using fork().
 *
 *     The parent waits for the child to complete using
 *     wait().
 *
 * ============================================================
 */

#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <stdlib.h>

int main()
{
    int status;

    printf("================================================\n");
    printf("       PARENT-CHILD SYNCHRONIZATION\n");
    printf("================================================\n");

    int processID = fork();

    if (processID < 0)
    {
        printf("Fork failed.\n");
        return 1;
    }

    if (processID == 0)
    {
        /*
         * Child process
         */
        printf("\nChild process started.\n");

        printf("Child PID  : %d\n", getpid());
        printf("Parent PID : %d\n", getppid());

        printf("Child is performing its work...\n");

        sleep(2);

        printf("Child process completed.\n");

        exit(0);
    }
    else
    {
        /*
         * Parent process
         */
        printf("\nParent process started.\n");

        printf("Parent PID : %d\n", getpid());
        printf("Child PID  : %d\n", processID);

        printf("Parent is waiting for child...\n");

        wait(&status);

        printf("\nChild has completed execution.\n");

        if (WIFEXITED(status))
        {
            printf("Child exited normally.\n");
        }

        printf("Parent process continues.\n");
        printf("Parent process completed.\n");
    }

    printf("\n================================================\n");

    return 0;
}
