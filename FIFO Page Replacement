#include <stdio.h>

int main() {
    int pages[] = {1,2,3,4,1,2,5,1,2,3,4,5};
    int frame[4] = {-1,-1,-1,-1};
    int pos = 0, fault = 0;
    int i, j, hit;

    for(i = 0; i < 12; i++) {
        hit = 0;

        for(j = 0; j < 4; j++) {
            if(frame[j] == pages[i])
                hit = 1;
        }

        if(!hit) {
            frame[pos] = pages[i];
            pos = (pos + 1) % 4;
            fault++;
        }

        printf("%d : ", pages[i]);

        for(j = 0; j < 4; j++)
            printf("%d ", frame[j]);

        printf("\n");
    }

    printf("Page Faults = %d\n", fault);

    return 0;
}
