/*
 * ============================================================
 *           SHORTEST JOB FIRST - NON PREEMPTIVE
 * ============================================================
 *
 * Description:
 *     The process having the smallest burst time is executed
 *     first.
 *
 *     All processes are assumed to arrive at time 0.
 *
 * ============================================================
 */

#include <stdio.h>

typedef struct
{
    int processNumber;
    int burstTime;
    int waitingTime;
    int turnaroundTime;
} Process;

/*
 * Swap two processes.
 */
void swap(Process *a, Process *b)
{
    Process temp = *a;
    *a = *b;
    *b = temp;
}

/*
 * Sort processes according to burst time.
 */
void sortProcesses(Process processes[], int n)
{
    for (int i = 0; i < n - 1; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            if (processes[i].burstTime >
                processes[j].burstTime)
            {
                swap(&processes[i], &processes[j]);
            }
        }
    }
}

/*
 * Calculate waiting time.
 */
void calculateWaitingTime(Process processes[], int n)
{
    processes[0].waitingTime = 0;

    for (int i = 1; i < n; i++)
    {
        processes[i].waitingTime =
            processes[i - 1].waitingTime +
            processes[i - 1].burstTime;
    }
}

/*
 * Calculate turnaround time.
 */
void calculateTurnaroundTime(Process processes[], int n)
{
    for (int i = 0; i < n; i++)
    {
        processes[i].turnaroundTime =
            processes[i].waitingTime +
            processes[i].burstTime;
    }
}

int main()
{
    int n;

    printf("================================================\n");
    printf("       SJF NON-PREEMPTIVE SCHEDULING\n");
    printf("================================================\n");

    printf("\nEnter number of processes: ");
    scanf("%d", &n);

    if (n <= 0)
    {
        printf("Invalid number of processes.\n");
        return 1;
    }

    Process processes[n];

    printf("\nEnter burst times:\n");

    for (int i = 0; i < n; i++)
    {
        processes[i].processNumber = i + 1;

        printf("P%d: ", i + 1);
        scanf("%d", &processes[i].burstTime);

        if (processes[i].burstTime <= 0)
        {
            printf("Invalid burst time.\n");
            return 1;
        }
    }

    /*
     * Sort according to burst time.
     */
    sortProcesses(processes, n);

    /*
     * Calculate waiting time and turnaround time.
     */
    calculateWaitingTime(processes, n);
    calculateTurnaroundTime(processes, n);

    double totalWT = 0;
    double totalTAT = 0;

    printf("\nExecution Order:\n");

    for (int i = 0; i < n; i++)
    {
        printf(
            "P%d",
            processes[i].processNumber
        );

        if (i < n - 1)
        {
            printf(" -> ");
        }

        totalWT += processes[i].waitingTime;
        totalTAT += processes[i].turnaroundTime;
    }

    printf("\n\n------------------------------------------------------------\n");

    printf("Process\tBT\tWT\tTAT\n");

    printf("------------------------------------------------------------\n");

    for (int i = 0; i < n; i++)
    {
        printf(
            "P%d\t%d\t%d\t%d\n",
            processes[i].processNumber,
            processes[i].burstTime,
            processes[i].waitingTime,
            processes[i].turnaroundTime
        );
    }

    printf("------------------------------------------------------------\n");

    printf(
        "Average Waiting Time    : %.2f\n",
        totalWT / n
    );

    printf(
        "Average Turnaround Time : %.2f\n",
        totalTAT / n
    );

    printf("============================================================\n");

    return 0;
}
