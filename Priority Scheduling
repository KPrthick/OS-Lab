/*
 * ============================================================
 *                PRIORITY CPU SCHEDULING
 * ============================================================
 *
 * Description:
 *     In this implementation, a smaller priority number means
 *     a higher priority.
 *
 *     Example:
 *
 *     Priority 1 > Priority 2 > Priority 3
 *
 *     All processes are assumed to arrive at time 0.
 *
 * ============================================================
 */

#include <stdio.h>

typedef struct
{
    int processNumber;
    int burstTime;
    int priority;
    int waitingTime;
    int turnaroundTime;
} Process;

/*
 * Swap two process structures.
 */
void swap(Process *a, Process *b)
{
    Process temp = *a;
    *a = *b;
    *b = temp;
}

/*
 * Sort processes by priority.
 */
void sortByPriority(Process processes[], int n)
{
    for (int i = 0; i < n - 1; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            if (processes[i].priority >
                processes[j].priority)
            {
                swap(&processes[i], &processes[j]);
            }
        }
    }
}

/*
 * Calculate waiting time.
 */
void calculateWaitingTime(Process processes[], int n)
{
    processes[0].waitingTime = 0;

    for (int i = 1; i < n; i++)
    {
        processes[i].waitingTime =
            processes[i - 1].waitingTime +
            processes[i - 1].burstTime;
    }
}

/*
 * Calculate turnaround time.
 */
void calculateTurnaroundTime(Process processes[], int n)
{
    for (int i = 0; i < n; i++)
    {
        processes[i].turnaroundTime =
            processes[i].waitingTime +
            processes[i].burstTime;
    }
}

int main()
{
    int n;

    printf("================================================\n");
    printf("             PRIORITY SCHEDULING\n");
    printf("================================================\n");

    printf("\nNote: Smaller priority number = Higher priority\n");

    printf("\nEnter number of processes: ");
    scanf("%d", &n);

    if (n <= 0)
    {
        printf("Invalid number of processes.\n");
        return 1;
    }

    Process processes[n];

    printf("\nEnter process details:\n");

    for (int i = 0; i < n; i++)
    {
        processes[i].processNumber = i + 1;

        printf("\nProcess P%d\n", i + 1);

        printf("Burst Time: ");
        scanf("%d", &processes[i].burstTime);

        printf("Priority: ");
        scanf("%d", &processes[i].priority);

        if (processes[i].burstTime <= 0 ||
            processes[i].priority < 0)
        {
            printf("Invalid input.\n");
            return 1;
        }
    }

    sortByPriority(processes, n);

    calculateWaitingTime(processes, n);
    calculateTurnaroundTime(processes, n);

    double totalWT = 0;
    double totalTAT = 0;

    printf("\nExecution Order:\n");

    for (int i = 0; i < n; i++)
    {
        printf("P%d", processes[i].processNumber);

        if (i < n - 1)
        {
            printf(" -> ");
        }

        totalWT += processes[i].waitingTime;
        totalTAT += processes[i].turnaroundTime;
    }

    printf("\n\n------------------------------------------------------------\n");

    printf("Process\tBT\tPriority\tWT\tTAT\n");

    printf("------------------------------------------------------------\n");

    for (int i = 0; i < n; i++)
    {
        printf(
            "P%d\t%d\t%d\t\t%d\t%d\n",
            processes[i].processNumber,
            processes[i].burstTime,
            processes[i].priority,
            processes[i].waitingTime,
            processes[i].turnaroundTime
        );
    }

    printf("------------------------------------------------------------\n");

    printf(
        "Average Waiting Time    : %.2f\n",
        totalWT / n
    );

    printf(
        "Average Turnaround Time : %.2f\n",
        totalTAT / n
    );

    printf("============================================================\n");

    return 0;
}
