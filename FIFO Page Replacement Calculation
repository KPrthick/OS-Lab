/*
 * ============================================================
 *             FIFO PAGE REPLACEMENT CALCULATION
 * ============================================================
 *
 * Description:
 *     This program calculates page hits and page faults using
 *     the FIFO page replacement algorithm.
 *
 * Example:
 *
 *     Reference String:
 *     7 0 1 2 0 3 0 4 2 3 0 3 2
 *
 *     Number of Frames:
 *     3
 *
 * ============================================================
 */

#include <stdio.h>

int searchPage(
    int frames[],
    int frameCount,
    int page)
{
    for (int i = 0; i < frameCount; i++)
    {
        if (frames[i] == page)
        {
            return 1;
        }
    }

    return 0;
}

void displayFrames(
    int frames[],
    int frameCount)
{
    printf("[ ");

    for (int i = 0; i < frameCount; i++)
    {
        if (frames[i] == -1)
        {
            printf("- ");
        }
        else
        {
            printf("%d ", frames[i]);
        }
    }

    printf("]");
}

int main()
{
    int n;
    int frameCount;

    printf("================================================\n");
    printf("             FIFO PAGE REPLACEMENT\n");
    printf("================================================\n");

    printf("\nEnter number of page references: ");
    scanf("%d", &n);

    if (n <= 0)
    {
        printf("Invalid number of references.\n");
        return 1;
    }

    int pages[n];

    printf("\nEnter reference string:\n");

    for (int i = 0; i < n; i++)
    {
        scanf("%d", &pages[i]);
    }

    printf("\nEnter number of frames: ");
    scanf("%d", &frameCount);

    if (frameCount <= 0)
    {
        printf("Invalid number of frames.\n");
        return 1;
    }

    int frames[frameCount];

    /*
     * Initialize all frames as empty.
     */
    for (int i = 0; i < frameCount; i++)
    {
        frames[i] = -1;
    }

    int pointer = 0;
    int pageFaults = 0;
    int pageHits = 0;

    printf("\n------------------------------------------------------------\n");
    printf("Page\tResult\tFrames\n");
    printf("------------------------------------------------------------\n");

    for (int i = 0; i < n; i++)
    {
        int currentPage = pages[i];

        if (searchPage(
                frames,
                frameCount,
                currentPage))
        {
            /*
             * Page is already present.
             */
            pageHits++;

            printf("%d\tHIT\t",
                   currentPage);
        }
        else
        {
            /*
             * Page is not present.
             */
            pageFaults++;

            frames[pointer] = currentPage;

            /*
             * Move FIFO pointer.
             */
            pointer =
                (pointer + 1) % frameCount;

            printf("%d\tFAULT\t",
                   currentPage);
        }

        displayFrames(
            frames,
            frameCount
        );

        printf("\n");
    }

    printf("------------------------------------------------------------\n");

    printf("\n================ RESULTS ================\n");

    printf("Total References : %d\n", n);
    printf("Number of Frames : %d\n", frameCount);
    printf("Page Hits        : %d\n", pageHits);
    printf("Page Faults      : %d\n", pageFaults);

    printf(
        "Page Fault Rate  : %.2f%%\n",
        ((double)pageFaults / n) * 100
    );

    printf(
        "Page Hit Rate    : %.2f%%\n",
        ((double)pageHits / n) * 100
    );

    printf("==========================================\n");

    return 0;
}
